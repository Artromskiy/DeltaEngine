             xmlns:uc="clr-namespace:Delta.Engine.Editor;assembly=Delta.Engine.Editor"
             mc:Ignorable="d" d:DesignWidth="455" d:DesignHeight="20"
             x:Class="Delta.Engine.Editor.IntNodeControl">

