<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StripSymbols>true</StripSymbols>
    <RootNamespace>Delta.Engine.Runner</RootNamespace>
    <AssemblyName>Delta.Engine.Runner</AssemblyName>
    <PackageId>Delta.Engine.Runner</PackageId>
    <Configurations>Debug;Release;DebugPerf;Perf</Configurations>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Delta.Engine.EditorLib\Delta.Engine.EditorLib.csproj" />
    <ProjectReference Include="..\Delta.Engine\Delta.Engine.csproj" />
  </ItemGroup>

</Project>
